# Development environment example. Copy to terraform.tfvars and fill in secrets
# via environment variables or a secrets manager, never commit real values.
environment            = "dev"
region                 = "us-east-1"
eks_node_instance_type = "t3.medium"
eks_node_min_count     = 2
eks_node_desired_count = 2
eks_node_max_count     = 3
db_instance_class      = "db.t3.micro"
db_allocated_storage   = 20

tags = {
  Project     = "cloud-native-platform"
  ManagedBy   = "terraform"
  Environment = "dev"
}
