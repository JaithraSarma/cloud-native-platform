# Example environment variables for cloud-native-platform.
# This file is a template — copy it to `.env` (untracked, see .gitignore) and
# fill in real values. Never commit actual secrets.

# --- API (api/src) ---
NODE_ENV=development            # development | production | test
PORT=3001                       # Port the API server listens on
DB_HOST=localhost               # PostgreSQL host
DB_PORT=5432                    # PostgreSQL port
DB_NAME=cloudplatform           # PostgreSQL database name
DB_USER=appuser                 # PostgreSQL username
DB_PASSWORD=changeme            # PostgreSQL password (use a real secret locally, never commit)
CORS_ORIGIN=*                   # Allowed CORS origin(s) for the API, e.g. http://localhost:8080

# --- Monitoring (docker-compose --profile monitoring) ---
GF_SECURITY_ADMIN_PASSWORD=changeme   # Grafana admin password (use a real secret locally, never commit)

# --- Terraform / Azure deploys (infra/terraform) ---
# These are read by Terraform as TF_VAR_<name> and map to variables.tf
# (db_admin_username / db_admin_password). Set them in your shell or CI
# secrets store — do not put real credentials in a committed file.
TF_VAR_db_admin_username=dbadmin        # Azure PostgreSQL Flexible Server admin username
TF_VAR_db_admin_password=changeme       # Azure PostgreSQL Flexible Server admin password
